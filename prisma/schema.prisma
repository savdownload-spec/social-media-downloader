// Prisma schema for Social Media Downloader
// PostgreSQL everywhere (dev and production point at separate databases,
// e.g. two Neon branches, via DATABASE_URL) — Vercel's serverless functions
// have no persistent filesystem, so SQLite cannot provide real persistence
// in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through Neon's pooled endpoint (host contains
  // "-pooler"), which is what serverless functions need — each invocation
  // opens its own connection and the direct endpoint runs out.
  url       = env("DATABASE_URL")
  // Schema changes need a direct connection: the pooler is PgBouncer in
  // transaction mode, where DDL does not work reliably. This is REQUIRED —
  // Prisma fails to load the schema at all if DIRECT_URL is missing, so it
  // must be set in every environment, including Vercel.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (NextAuth compatible)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  role              String    @default("USER")
  password          String?
  jobTitle          String?
  company           String?
  bio               String?
  /// Cross-device sync of the user's manual theme choice ('light' | 'dark' |
  /// 'auto'). localStorage is the source of truth per-device; this column
  /// only seeds a fresh device that has no local value yet.
  themePreference   String?
  /// Stamped whenever the user's password changes. JWT tokens issued before
  /// this timestamp are treated as expired, forcing re-login after a password
  /// reset or change. NULL means no change has occurred — all tokens valid.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ── Billing ────────────────────────────────────────────────────────────────
  // `plan` is the entitlement the user currently has; it is derived from Stripe
  // by the webhook and is never trusted from the client.
  stripeCustomerId   String?   @unique
  safepayCustomerId  String?   @unique
  plan               String    @default("FREE") // FREE | PRO | MAX | LIFETIME
  /// Allowance that refills each period and does NOT roll over. Free users get
  /// a daily refill, paid plans a monthly one — `planCreditsResetAt` marks when
  /// the current allowance expires.
  planCredits        Int       @default(0)
  planCreditsResetAt DateTime?
  /// Credits bought outright in a pack. These never expire and never reset.
  purchasedCredits   Int       @default(0)
  /// Referral reward credits are tracked separately because each grant expires
  /// independently and must never reduce purchased or plan credits.
  referralCredits    Int       @default(0)

  accounts                     Account[]
  sessions                     Session[]
  downloads                    Download[]
  aiImageGenerations           AiImageGeneration[]
  reviews                      Review[]
  blogComments                 BlogComment[]         @relation("BlogCommentAuthor")
  moderatedBlogComments        BlogComment[]         @relation("BlogCommentModerator")
  subscriptions                Subscription[]
  creditLedger                 CreditTransaction[]
  payments                     Payment[]
  supportConversations         SupportConversation[] @relation("SupportCustomer")
  assignedSupportConversations SupportConversation[] @relation("SupportAssignee")
  supportMessages              SupportMessage[]      @relation("SupportSender")
  adminNotificationReads       AdminNotificationRead[] @relation("AdminNotificationReader")
  referredBy                   Referral? @relation("ReferredUser")
  socialMembership             SocialMember?
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────────────────────

/// Mirror of the Stripe subscription, kept in sync by the webhook so the app
/// never has to call Stripe on a page render.
model Subscription {
  id                    String    @id @default(cuid())
  userId                String
  provider              String    @default("STRIPE") // STRIPE | SAFEPAY
  stripeSubscriptionId  String    @unique
  safepaySubscriptionId String?   @unique
  stripePriceId         String
  /// active | trialing | past_due | canceled | unpaid | incomplete
  status                String
  plan                  String // PRO | MAX
  interval              String // month | year
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider, status])
}

/// Append-only audit trail of every credit movement, so a balance can always be
/// explained and a webhook replay can be detected.
model CreditTransaction {
  id                    String   @id @default(cuid())
  userId                String
  /// Positive to grant, negative to spend.
  amount                Int
  /// purchase | plan_refill | plan_grant | spend | refund | adjustment
  kind                  String
  /// Which bucket moved: plan | purchased | referral | mixed
  bucket                String   @default("purchased")
  description           String?
  /// Stripe event / session / invoice id. Unique so replays cannot double-grant.
  externalId            String?  @unique
  /// Stable request/event key used for retry deduplication.
  idempotencyKey        String?  @unique
  /// Structured links replace description parsing in analytics. They remain
  /// nullable because legacy rows cannot always be linked safely.
  operationId           String?
  paymentId             String?
  /// Exact movement in each balance bucket. `amount` is their sum.
  planDelta             Int      @default(0)
  purchasedDelta        Int      @default(0)
  referralDelta         Int      @default(0)
  /// Balance snapshot immediately after the movement.
  balanceAfter          Int?
  planBalanceAfter      Int?
  purchasedBalanceAfter Int?
  referralBalanceAfter  Int?
  /// Referral reward credit expiration timestamp, when this movement grants
  /// expiring referral credits.
  expiresAt             DateTime?
  /// The reward transaction associated with a referral, if this is its grant.
  referralId            String?  @unique
  createdAt             DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation Download? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  referral  Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  creditAllocations CreditAllocation[]

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([operationId, createdAt])
  @@index([paymentId])
  @@index([createdAt])
}

/// Idempotency guard for the Stripe webhook: Stripe retries deliveries, and an
/// event that has already been recorded here is acknowledged without replaying
/// its side effects.
model ProcessedStripeEvent {
  id          String   @id // the Stripe event id
  type        String
  processedAt DateTime @default(now())
}

/// Provider-neutral payment audit record used by Admin for Safepay transactions.
model Payment {
  id                String    @id @default(cuid())
  provider          String
  providerPaymentId String
  userId            String?
  itemId            String?
  amount            Int
  currency          String
  status            String
  reference         String?
  subscriptionId    String?
  metadata          Json?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  creditTransactions CreditTransaction[]

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProcessedSafepayEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Downloader tracking
// ─────────────────────────────────────────────────────────────────────────────

model Download {
  id             String    @id @default(cuid())
  platform       String
  tool           String
  sourceUrl      String
  /// pending | processing | success | failed | cancelled
  status         String    @default("pending")
  /// Client request keys are scoped to the authenticated user by the server.
  idempotencyKey String?   @unique
  batchId        String?
  failureReason  String?
  /// Stable, non-sensitive diagnostic code (for example auth_required).
  failureCode    String?
  creditCost     Int       @default(0)
  userId         String?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  completedAt    DateTime?

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  creditTransactions CreditTransaction[]
  aiImageGeneration  AiImageGeneration?

  @@index([tool, createdAt])
  @@index([platform, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([batchId])
  @@index([createdAt])
}

/// Dedicated history for AI image generations. `Download` above is an
/// intentionally minimal write-only marker shared by every tool; this table
/// holds the extra per-generation metadata (model, aspect ratio, quality,
/// cost, failure reason) that the AI Image Generator's history view needs
/// and `Download` has no columns for.
model AiImageGeneration {
  id             String   @id @default(cuid())
  userId         String
  operationId    String?  @unique
  prompt         String   @db.Text
  aspectRatio    String
  quality        String
  model          String
  numberOfImages Int
  creditsUsed    Int
  status         String // success | failed
  failureReason  String?
  createdAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation Download? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String
  referrer  String?
  country   String?
  device    String?
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([path, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  title                 String
  excerpt               String?
  content               String
  coverImage            String?
  author                String    @default("Editorial Team")
  tagsJson              String    @default("[]")
  category              String    @default("Guides")
  coverAlt              String?
  ogImage               String?
  primaryKeyword        String?
  secondaryKeywordsJson String    @default("[]")
  canonicalUrl          String?
  toolSlug              String?
  readingTimeMinutes    Int?
  published             Boolean   @default(false)
  publishedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // ── Content Studio: Tiptap source of truth ──────────────────────────────
  // `content` (above) stays in sync as a markdown export on every save from
  // the new editor, so the legacy renderer and search/excerpts keep working.
  // Posts never opened in the new editor keep contentJson null.
  contentJson Json?

  // ── Content Studio: SEO fields ───────────────────────────────────────────
  // Explicit override columns. Null falls back to the same title/excerpt
  // chain normalizeDbPost() already used, so unedited posts render unchanged.
  seoTitle           String?
  metaDescription    String?
  focusKeyphrase     String?
  synonymsJson       String    @default("[]")
  noIndex            Boolean   @default(false)
  noFollow           Boolean   @default(false)
  metaRobotsAdvanced String?
  breadcrumbTitle    String?
  schemaType         String?
  faqJson            String    @default("[]")
  howToJson          String    @default("[]")
  ogTitle            String?
  ogDescription      String?
  scheduledAt        DateTime?
  seoScore           Int?
  readabilityScore   Int?
  wordCount          Int?

  revisions PostRevision[]

  // ── Author profile relation ──────────────────────────────────────────────
  // The original `author` String field is preserved for backward compat.
  // `authorId` is nullable so all existing posts remain valid.
  authorId   String?
  blogAuthor BlogAuthor? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@index([authorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Blog Author Profiles
// ─────────────────────────────────────────────────────────────────────────────

model BlogAuthor {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  /// Admin-only contact address. Never selected by public author queries.
  email        String?
  profileImage String?
  role         String   @default("Author")
  shortBio     String?
  extendedBio  String?  @db.Text
  expertiseJson String  @default("[]")
  website      String?
  /// Platform -> URL map. Only allowlisted http(s) URLs are exposed publicly.
  socialsJson  String   @default("{}")
  /// Drafts are hidden from the public directory, profile pages, and sitemap.
  published    Boolean  @default(true)
  /// Seeded demo profiles are noindexed and excluded from the sitemap.
  isSample     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts         Post[]
  slugRedirects AuthorSlugRedirect[]

  @@index([slug])
  @@index([published])
}

/// Old author slugs kept after a rename so previously indexed/shared profile
/// URLs can permanently redirect to the author's current slug.
model AuthorSlugRedirect {
  oldSlug   String     @id
  authorId  String
  author    BlogAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([authorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Article Feedback
// ─────────────────────────────────────────────────────────────────────────────

model ArticleFeedback {
  id        String   @id @default(cuid())
  postSlug  String
  helpful   Boolean
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([postSlug, helpful])
  @@index([createdAt])
}
model PostRevision {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  snapshotJson  Json
  changeSummary String?
  authorId      String?
  authorEmail   String?
  createdAt     DateTime @default(now())

  @@index([postId, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  status    String   @default("pending")
  source    String   @default("homepage-monthly-update")
  provider  String?
  providerSubscriberId String?
  providerListId String?
  subscribedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
}

model ContactMessage {
  id                    String   @id @default(cuid())
  name                  String
  email                 String
  subject               String?
  message               String
  status                String   @default("NEW") // NEW | IN_PROGRESS | RESOLVED
  emailNotificationSent Boolean  @default(false)
  emailDeliveryFailed   Boolean  @default(false)
  idempotencyKey        String?  @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

// Human support. Guest conversations are protected by a hashed, random browser
// token; authenticated conversations always belong to the existing User record.
model SupportConversation {
  id                  String    @id @default(cuid())
  userId              String?
  guestName           String?
  guestEmail          String?
  guestTokenHash      String?
  category            String
  status              String    @default("OPEN") // OPEN | WAITING_FOR_REPLY | IN_PROGRESS | RESOLVED | CLOSED
  priority            String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assignedAdminId     String?
  lastMessagePreview  String    @default("")
  lastMessageAt       DateTime  @default(now())
  customerUnreadCount Int       @default(0)
  adminUnreadCount    Int       @default(0)
  customerLastReadAt  DateTime?
  adminLastReadAt     DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user          User?            @relation("SupportCustomer", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin User?            @relation("SupportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([userId, lastMessageAt])
  @@index([guestEmail, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([assignedAdminId, status, lastMessageAt])
  @@index([priority, status])
}

model SupportMessage {
  id                String   @id @default(cuid())
  conversationId    String
  senderType        String // CUSTOMER | ADMIN | SYSTEM
  senderId          String?
  body              String
  originalMessage   String?
  detectedLanguage  String?
  translatedMessage String?
  translationStatus String? // PENDING | TRANSLATED | NOT_NEEDED | FAILED
  internal          Boolean  @default(false)
  createdAt         DateTime @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("SupportSender", fields: [senderId], references: [id], onDelete: SetNull)
  attachments  SupportAttachment[]

  @@index([conversationId, createdAt])
}

model SupportAttachment {
  id          String   @id @default(cuid())
  messageId   String
  fileName    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Review {
  id         String    @id @default(cuid())
  userId     String?
  name       String
  email      String?
  role       String?
  company    String?
  platform   String    @default("direct")
  rating     Int
  review     String
  // Source of truth: PENDING | APPROVED | REJECTED
  status     String    @default("PENDING")
  // Mirrors status === 'APPROVED' — kept for backward compatibility with
  // existing queries that reference `approved`.
  approved   Boolean   @default(false)
  featured   Boolean   @default(false)
  verified   Boolean   @default(false)
  sourceUrl  String?
  photo      String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, featured, createdAt])
  @@index([approved, featured, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────────────────────────────────────

/// One row per attempted automatic-backup execution. The (kind, dateKey)
/// unique constraint is the atomic daily lock: concurrent cron invocations on
/// the same UTC date claim the row once and take it over only after a stale or
/// failed attempt. Manual and recovery archives are tracked by AuditLog.
model BackupRun {
  id           String    @id @default(cuid())
  kind         String // AUTOMATIC
  dateKey      String? // YYYY-MM-DD (UTC); NULL rows would not collide
  status       String // RUNNING | COMPLETED | FAILED | VERIFICATION_FAILED
  trigger      String // cron | external | admin
  attempts     Int       @default(1)
  backupId     String?   @unique
  fileName     String?
  size         Int?
  sha256       String?
  recordCounts Json?
  fileCount    Int?
  warnings     Json?
  error        String?
  createdBy    String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([kind, dateKey])
  @@index([status, startedAt])
  @@index([startedAt])
}

/// Append-only record of every significant admin action.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String // e.g. "user.suspend", "credit.add", "review.approve"
  targetType String? // "User" | "Review" | "Subscription" | ...
  targetId   String?
  detail     Json? // arbitrary extra context (old/new values, reason)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

/// Actionable events shown in the existing Admin bell/sidebar notification UI.
/// A stable dedupeKey makes public API retries and webhook replays idempotent.
model AdminNotification {
  id         String    @id @default(cuid())
  type       String
  section    String
  entityType String
  entityId   String
  title      String
  message    String
  href       String
  dedupeKey  String    @unique
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  reads AdminNotificationRead[]

  @@index([section, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([resolvedAt])
}

/// Read state belongs to an individual admin; moderation/payment state remains
/// on the source record and is deliberately independent from this receipt.
model AdminNotificationRead {
  notificationId String
  adminId        String
  readAt         DateTime @default(now())

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin        User              @relation("AdminNotificationReader", fields: [adminId], references: [id], onDelete: Cascade)

  @@id([notificationId, adminId])
  @@index([adminId, readAt])
}

/// Admin-managed per-tool configuration (status, free limit, credit cost, batch limits).
model ToolConfig {
  id         String @id @default(cuid())
  slug       String @unique
  name       String
  category   String
  status     String @default("LIVE") // LIVE | COMING_SOON | MAINTENANCE | DISABLED
  creditCost Int    @default(0)
  freeLimit  Int    @default(0) // 0 = unlimited (legacy, kept for display)

  /// Per-plan batch file limits. NULL means "use the code default from batchLimits.ts".
  batchLimitFree     Int?
  batchLimitPro      Int?
  batchLimitMax      Int?
  batchLimitLifetime Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Key-value store for admin-configurable settings.
model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Affiliate tracking.
model Affiliate {
  id               String   @id @default(cuid())
  userId           String   @unique
  code             String   @unique
  commissionRate   Float    @default(0.2) // 20 %
  status           String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED
  totalClicks      Int      @default(0)
  totalSignups     Int      @default(0)
  totalConversions Int      @default(0)
  totalRevenue     Float    @default(0)
  totalCommission  Float    @default(0)
  paidOut          Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  referrals Referral[]

  @@index([status])
}

/// One first-touch attribution per newly registered user. `remainingCredits`
/// tracks the unspent part of its single 20-credit reward; `expiredCredits`
/// preserves how much was forfeited when the one-month window elapsed.
model Referral {
  id                String   @id @default(cuid())
  affiliateId       String
  referredUserId    String   @unique
  code              String
  /// PENDING | QUALIFIED | REJECTED
  status            String
  rejectionReason   String?
  rewardCredits     Int      @default(0)
  remainingCredits  Int      @default(0)
  expiredCredits    Int      @default(0)
  /// Frozen estimated accounting value for the reward at grant time.
  estimatedUsdValue Decimal? @db.Decimal(12, 6)
  createdAt         DateTime @default(now())
  qualifiedAt       DateTime?
  rewardedAt        DateTime?
  expiresAt         DateTime?

  affiliate        Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser     User               @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  rewardTransaction CreditTransaction?
  allocations      CreditAllocation[]

  @@index([affiliateId, createdAt])
  @@index([affiliateId, status, createdAt])
  @@index([status, expiresAt])
}

/// Links the expiring reward lot(s) used by a spend so a failed operation can
/// return credits to their original lots without extending their expiry.
model CreditAllocation {
  id                 String   @id @default(cuid())
  referralId         String
  spendTransactionId String
  amount             Int
  refundedAmount     Int      @default(0)
  createdAt          DateTime @default(now())

  referral         Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  spendTransaction CreditTransaction @relation(fields: [spendTransactionId], references: [id], onDelete: Cascade)

  @@unique([spendTransactionId, referralId])
  @@index([referralId, createdAt])
}

model BlogComment {
  id            String    @id @default(cuid())
  postSlug      String
  userId        String
  body          String
  status        String    @default("PENDING") // PENDING | APPROVED | HIDDEN | REJECTED
  reportReason  String?
  reportedAt    DateTime?
  approvedAt    DateTime?
  moderatedAt   DateTime?
  moderatedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User  @relation("BlogCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  moderator User? @relation("BlogCommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([postSlug, status, createdAt])
  @@index([status, reportedAt])
  @@index([userId, createdAt])
}

/// A generated Users data export (Admin > Users export drawer). Tracks
/// generation status and the resulting file(s) so the admin UI can show an
/// export history with real progress instead of a fire-and-forget download.
model UserExportJob {
  id          String    @id @default(cuid())
  adminId     String
  adminEmail  String
  status      String    @default("PROCESSING") // PROCESSING | COMPLETED | FAILED | EXPIRED
  scope       String // all | filtered | selected
  userCount   Int       @default(0)
  dateField   String? // createdAt | updatedAt
  dateFrom    DateTime?
  dateTo      DateTime?
  fieldsJson  Json // string[] of exported field ids
  formatsJson Json // string[] of requested formats (csv|xlsx|json|pdf|zip)
  fileName    String? // primary file name shown in history (zip name if zip was requested, else the first format)
  fileUrl     String? // primary download URL (Vercel Blob, or local path in dev)
  fileSize    Int? // primary file size in bytes
  filesJson   Json? // every generated file: { format, name, url, size }[] — lets multi-format exports (without zip) each stay downloadable
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  @@index([adminId, createdAt])
  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Social Media Manager
//
// Single-tenant publishing console for the site owner's own accounts. Access
// tokens are stored ONLY as AES-256-GCM ciphertext (see src/lib/social/crypto.ts)
// and are never selected into client responses. Posts store schedule times in
// UTC; rendering converts to the configured admin timezone.
// ─────────────────────────────────────────────────────────────────────────────

/// A connected social account. `accessToken`/`refreshToken` hold versioned
/// ciphertext (`v1:iv:tag:ct`) and must never be exposed to the browser.
model SocialAccount {
  id                String    @id @default(cuid())
  platform          String // FACEBOOK | INSTAGRAM | LINKEDIN | PINTEREST | BLUESKY | MASTODON
  externalAccountId String
  accountName       String
  username          String?
  avatarUrl         String?
  accountType       String // PAGE | PROFILE | CHANNEL | ...
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scopes            String?
  status            String    @default("CONNECTED") // CONNECTED | EXPIRING | EXPIRED | REVOKED | ERROR
  /// Non-secret provider identifiers and cached options (page id, boards, subreddits).
  metadata          Json?
  lastConnectedAt   DateTime?
  lastPublishedAt   DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  variants SocialPostVariant[]
  attempts PublishingAttempt[]

  @@unique([platform, externalAccountId])
  @@index([platform, status])
}

/// Uploaded media. `provider` is BLOB (Vercel Blob) or LOCAL (dev filesystem).
model SocialMediaAsset {
  id              String    @id @default(cuid())
  url             String
  pathname        String?
  provider        String    @default("BLOB")
  kind            String // IMAGE | VIDEO
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  durationSeconds Float?
  altText         String?
  name            String
  checksum        String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  posts SocialPostMedia[]

  @@index([kind, createdAt])
  @@index([deletedAt])
}

/// Master post shared across platforms. `caption` is the default content;
/// each variant may override it.
model SocialPost {
  id           String    @id @default(cuid())
  title        String?
  caption      String    @default("")
  hashtags     String?
  linkUrl      String?
  status       String    @default("DRAFT") // DRAFT | SCHEDULED | QUEUED | PUBLISHING | PUBLISHED | PARTIAL | FAILED | NEEDS_AUTHORIZATION | MANUAL_ACTION_REQUIRED | CANCELLED
  scheduledAt  DateTime? // always UTC
  timezone     String    @default("Asia/Karachi")
  publishedAt  DateTime?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  variants SocialPostVariant[]
  media    SocialPostMedia[]
  jobs     PublishingJob[]

  @@index([status, scheduledAt])
  @@index([updatedAt])
}

model SocialPostVariant {
  id            String    @id @default(cuid())
  postId        String
  platform      String
  accountId     String?
  caption       String    @default("")
  title         String?
  hashtags      String?
  linkUrl       String?
  /// Platform-specific publishing options (boardId, subreddit, visibility, ...).
  options       Json?
  status        String    @default("DRAFT")
  remotePostId  String?
  publishedUrl  String?
  errorCode     String?
  errorMessage  String?
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  post     SocialPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  account  SocialAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  attempts PublishingAttempt[]

  // One variant per platform/account. accountId is NULL until an account is
  // connected, so uniqueness across accounts is also enforced in the API.
  @@unique([postId, platform, accountId])
  @@index([status])
  @@index([accountId])
  @@index([postId])
}

model SocialPostMedia {
  postId   String
  assetId  String
  position Int    @default(0)

  post  SocialPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset SocialMediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([postId, assetId])
  @@index([assetId])
}

/// Durable publishing queue. Claimed atomically with FOR UPDATE SKIP LOCKED;
/// `leaseUntil` lets a crashed worker's job be reclaimed.
model PublishingJob {
  id         String    @id @default(cuid())
  postId     String
  runAt      DateTime
  status     String    @default("QUEUED") // QUEUED | CLAIMED | DONE | FAILED | CANCELLED
  attempts   Int       @default(0)
  claimedBy  String?
  claimedAt  DateTime?
  leaseUntil DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  post     SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  attemptsLog PublishingAttempt[]

  @@index([status, runAt])
  @@index([postId])
}

/// One record per provider interaction. Provider payloads are scrubbed before
/// storage; tokens are never written here.
model PublishingAttempt {
  id               String    @id @default(cuid())
  jobId            String?
  variantId        String?
  accountId        String?
  platform         String
  attemptNo        Int       @default(1)
  httpStatus       Int?
  outcome          String // SUCCESS | FAILED | SKIPPED | MANUAL | UNKNOWN
  errorCode        String?
  message          String?
  providerResponse Json?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  durationMs       Int?

  job     PublishingJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  variant SocialPostVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  account SocialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([platform, startedAt])
  @@index([variantId])
  @@index([jobId])
}

/// One-time, hashed OAuth state bound to the initiating admin session.
model SocialOAuthState {
  id         String    @id @default(cuid())
  stateHash  String    @unique
  platform   String
  adminId    String
  /// Encrypted PKCE verifier (short-lived; never returned to the browser).
  verifier   String?
  redirectTo String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@index([adminId])
}

/// Module-scoped role. Global ADMIN users always resolve to SUPER_ADMIN.
model SocialMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      String // EDITOR | PUBLISHER
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
}

model SocialTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String
  /// { caption, hashtags, linkUrl, variants: [...] }
  content   Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Provider-sourced metrics only. A missing metric is rendered as
/// "Unavailable" — never estimated.
model SocialAnalyticsSnapshot {
  id         String   @id @default(cuid())
  accountId  String?
  platform   String
  variantId  String?
  capturedAt DateTime @default(now())
  metrics    Json
  source     String // e.g. "facebook.graph"

  @@index([platform, capturedAt])
  @@index([accountId, capturedAt])
}
