// Prisma schema for Social Media Downloader
// PostgreSQL everywhere (dev and production point at separate databases,
// e.g. two Neon branches, via DATABASE_URL) — Vercel's serverless functions
// have no persistent filesystem, so SQLite cannot provide real persistence
// in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through Neon's pooled endpoint (host contains
  // "-pooler"), which is what serverless functions need — each invocation
  // opens its own connection and the direct endpoint runs out.
  url       = env("DATABASE_URL")
  // Schema changes need a direct connection: the pooler is PgBouncer in
  // transaction mode, where DDL does not work reliably. This is REQUIRED —
  // Prisma fails to load the schema at all if DIRECT_URL is missing, so it
  // must be set in every environment, including Vercel.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (NextAuth compatible)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("USER")
  password      String?
  jobTitle      String?
  company       String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── Billing ────────────────────────────────────────────────────────────────
  // `plan` is the entitlement the user currently has; it is derived from Stripe
  // by the webhook and is never trusted from the client.
  stripeCustomerId   String?   @unique
  plan               String    @default("FREE") // FREE | PRO | MAX | LIFETIME
  /// Allowance that refills each period and does NOT roll over. Free users get
  /// a daily refill, paid plans a monthly one — `planCreditsResetAt` marks when
  /// the current allowance expires.
  planCredits        Int       @default(0)
  planCreditsResetAt DateTime?
  /// Credits bought outright in a pack. These never expire and never reset.
  purchasedCredits   Int       @default(0)

  accounts      Account[]
  sessions      Session[]
  downloads     Download[]
  reviews       Review[]
  blogComments  BlogComment[] @relation("BlogCommentAuthor")
  moderatedBlogComments BlogComment[] @relation("BlogCommentModerator")
  subscriptions Subscription[]
  creditLedger  CreditTransaction[]
  supportConversations SupportConversation[] @relation("SupportCustomer")
  assignedSupportConversations SupportConversation[] @relation("SupportAssignee")
  supportMessages SupportMessage[] @relation("SupportSender")
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────────────────────

/// Mirror of the Stripe subscription, kept in sync by the webhook so the app
/// never has to call Stripe on a page render.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String    @unique
  stripePriceId        String
  /// active | trialing | past_due | canceled | unpaid | incomplete
  status               String
  plan                 String // PRO | MAX
  interval             String // month | year
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Append-only audit trail of every credit movement, so a balance can always be
/// explained and a webhook replay can be detected.
model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  /// Positive to grant, negative to spend.
  amount      Int
  /// purchase | plan_refill | plan_grant | spend | refund | adjustment
  kind        String
  /// Which bucket moved: plan | purchased
  bucket      String   @default("purchased")
  description String?
  /// Stripe event / session / invoice id. Unique so replays cannot double-grant.
  externalId  String?  @unique
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Idempotency guard for the Stripe webhook: Stripe retries deliveries, and an
/// event that has already been recorded here is acknowledged without replaying
/// its side effects.
model ProcessedStripeEvent {
  id          String   @id // the Stripe event id
  type        String
  processedAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Downloader tracking
// ─────────────────────────────────────────────────────────────────────────────

model Download {
  id        String   @id @default(cuid())
  platform  String
  tool      String
  sourceUrl String
  status    String   @default("success")
  userId    String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tool, createdAt])
  @@index([platform, createdAt])
  @@index([userId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  path      String
  referrer  String?
  country   String?
  device    String?
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([path, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverImage          String?
  author              String    @default("Editorial Team")
  tagsJson            String    @default("[]")
  category            String    @default("Guides")
  coverAlt            String?
  ogImage             String?
  primaryKeyword      String?
  secondaryKeywordsJson String  @default("[]")
  canonicalUrl        String?
  toolSlug            String?
  readingTimeMinutes  Int?
  published           Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ── Content Studio: Tiptap source of truth ──────────────────────────────
  // `content` (above) stays in sync as a markdown export on every save from
  // the new editor, so the legacy renderer and search/excerpts keep working.
  // Posts never opened in the new editor keep contentJson null.
  contentJson         Json?

  // ── Content Studio: SEO fields ───────────────────────────────────────────
  // Explicit override columns. Null falls back to the same title/excerpt
  // chain normalizeDbPost() already used, so unedited posts render unchanged.
  seoTitle            String?
  metaDescription     String?
  focusKeyphrase      String?
  synonymsJson        String    @default("[]")
  noIndex             Boolean   @default(false)
  noFollow            Boolean   @default(false)
  metaRobotsAdvanced  String?
  breadcrumbTitle     String?
  schemaType          String?
  faqJson             String    @default("[]")
  howToJson           String    @default("[]")
  ogTitle             String?
  ogDescription       String?
  scheduledAt         DateTime?
  seoScore            Int?
  readabilityScore    Int?
  wordCount           Int?

  revisions PostRevision[]

  @@index([published, publishedAt])
}

model PostRevision {
  id            String   @id @default(cuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  snapshotJson  Json
  changeSummary String?
  authorId      String?
  authorEmail   String?
  createdAt     DateTime @default(now())

  @@index([postId, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

// Human support. Guest conversations are protected by a hashed, random browser
// token; authenticated conversations always belong to the existing User record.
model SupportConversation {
  id                 String   @id @default(cuid())
  userId             String?
  guestName          String?
  guestEmail         String?
  guestTokenHash     String?
  category           String
  status             String   @default("OPEN") // OPEN | WAITING_FOR_REPLY | IN_PROGRESS | RESOLVED | CLOSED
  priority           String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assignedAdminId    String?
  lastMessagePreview String   @default("")
  lastMessageAt      DateTime @default(now())
  customerUnreadCount Int     @default(0)
  adminUnreadCount    Int     @default(0)
  customerLastReadAt DateTime?
  adminLastReadAt    DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user          User?             @relation("SupportCustomer", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdmin User?             @relation("SupportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([userId, lastMessageAt])
  @@index([guestEmail, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([assignedAdminId, status, lastMessageAt])
  @@index([priority, status])
}

model SupportMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderType     String   // CUSTOMER | ADMIN | SYSTEM
  senderId       String?
  body           String
  internal       Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("SupportSender", fields: [senderId], references: [id], onDelete: SetNull)
  attachments  SupportAttachment[]

  @@index([conversationId, createdAt])
}

model SupportAttachment {
  id          String   @id @default(cuid())
  messageId   String
  fileName    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Review {
  id         String    @id @default(cuid())
  userId     String?
  name       String
  email      String?
  role       String?
  company    String?
  platform   String    @default("direct")
  rating     Int
  review     String
  // Source of truth: PENDING | APPROVED | REJECTED
  status     String    @default("PENDING")
  // Mirrors status === 'APPROVED' — kept for backward compatibility with
  // existing queries that reference `approved`.
  approved   Boolean   @default(false)
  featured   Boolean   @default(false)
  verified   Boolean   @default(false)
  sourceUrl  String?
  photo      String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, featured, createdAt])
  @@index([approved, featured, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only record of every significant admin action.
model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  action      String   // e.g. "user.suspend", "credit.add", "review.approve"
  targetType  String?  // "User" | "Review" | "Subscription" | ...
  targetId    String?
  detail      Json?    // arbitrary extra context (old/new values, reason)
  ip          String?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

/// Admin-managed per-tool configuration (status, free limit, credit cost).
model ToolConfig {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  status      String   @default("LIVE") // LIVE | COMING_SOON | MAINTENANCE | DISABLED
  creditCost  Int      @default(0)
  freeLimit   Int      @default(0)       // 0 = unlimited
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Key-value store for admin-configurable settings.
model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Affiliate tracking.
model Affiliate {
  id               String   @id @default(cuid())
  userId           String   @unique
  code             String   @unique
  commissionRate   Float    @default(0.2)  // 20 %
  status           String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED
  totalClicks      Int      @default(0)
  totalSignups     Int      @default(0)
  totalConversions Int      @default(0)
  totalRevenue     Float    @default(0)
  totalCommission  Float    @default(0)
  paidOut          Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

model BlogComment {
  id            String   @id @default(cuid())
  postSlug      String
  userId        String
  body          String
  status        String   @default("PENDING") // PENDING | APPROVED | HIDDEN | REJECTED
  reportReason  String?
  reportedAt    DateTime?
  approvedAt    DateTime?
  moderatedAt   DateTime?
  moderatedById String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation("BlogCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  moderator     User?    @relation("BlogCommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([postSlug, status, createdAt])
  @@index([status, reportedAt])
  @@index([userId, createdAt])
}

/// A generated Users data export (Admin > Users export drawer). Tracks
/// generation status and the resulting file(s) so the admin UI can show an
/// export history with real progress instead of a fire-and-forget download.
model UserExportJob {
  id            String    @id @default(cuid())
  adminId       String
  adminEmail    String
  status        String    @default("PROCESSING") // PROCESSING | COMPLETED | FAILED | EXPIRED
  scope         String    // all | filtered | selected
  userCount     Int       @default(0)
  dateField     String?   // createdAt | updatedAt
  dateFrom      DateTime?
  dateTo        DateTime?
  fieldsJson    Json      // string[] of exported field ids
  formatsJson   Json      // string[] of requested formats (csv|xlsx|json|pdf|zip)
  fileName      String?   // primary file name shown in history (zip name if zip was requested, else the first format)
  fileUrl       String?   // primary download URL (Vercel Blob, or local path in dev)
  fileSize      Int?      // primary file size in bytes
  filesJson     Json?     // every generated file: { format, name, url, size }[] — lets multi-format exports (without zip) each stay downloadable
  error         String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  expiresAt     DateTime

  @@index([adminId, createdAt])
  @@index([status, expiresAt])
}