# ──────────────────────────────────────────────────────────────────
# Environment Configuration Template
# ──────────────────────────────────────────────────────────────────
# Copy this file to:
#   .env.local     (local development)
#   .env           (production - DO NOT commit)
# 
# NEVER commit actual credentials to version control.
# ────────��─────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════
# Site Configuration
# ══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="SavDown"

# ══════════════════════════════════════════════════════════════════
# Database (Neon PostgreSQL)
# ══════════════════════════════════════════════════════════════════
# For local development: Use a separate Neon branch (e.g., "development")
# For production: Use main Neon branch
# NEVER point dev and prod at the same database

# Pooled connection (use in runtime queries)
DATABASE_URL="postgresql://[user]:[password]@[host]-pooler.[region].aws.neon.tech/[database]?sslmode=require"

# Direct connection (required for Prisma migrations)
DIRECT_URL="postgresql://[user]:[password]@[host].[region].aws.neon.tech/[database]?sslmode=require"

# ══════════════════════════════════════════════════════════════════
# Authentication (NextAuth)
# ══════════════════════════════════════════════════════════════════
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ══════════════════════════════════════════════════════════════════
# Google OAuth
# ══════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ══════════════════════════════════════════════════════════════════
# Stripe Payments (Test Mode for Development)
# ══════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_MAX_MONTHLY=price_...
STRIPE_PRICE_MAX_YEARLY=price_...
STRIPE_PRICE_PACK_STARTER=price_...
STRIPE_PRICE_PACK_STANDARD=price_...
STRIPE_PRICE_PACK_BULK=price_...
STRIPE_PRICE_LIFETIME=price_...

# ══════════════════════════════════════════════════════════════════
# Admin Configuration
# ══════════════════════════════════════════════════════════════════
ADMIN_EMAILS="admin@example.com"

# ══════════════════════════════════════════════════════════════════
# Redis (Optional - Rate Limiting & Caching)
# ══════════════════════════════════════════════════════════════════
# Leave empty to use in-memory fallback
REDIS_URL=

# ══════════════════════════════════════════════════════════════════
# Binary Paths (Downloaders & Processing)
# ══════════════════════════════════════════════════════════════════
# Local development (Windows): Full path to installed binaries
# Production (Vercel): Uses bundled binaries in bin/ directory

# yt-dlp (video downloaders)
YTDLP_BIN=
YTDLP_TIMEOUT_MS=30000

# gallery-dl (image galleries)
GALLERY_DL_BIN=
GALLERY_DL_TIMEOUT_MS=30000

# FFmpeg (video processing)
FFMPEG_BIN=
FFMPEG_TIMEOUT_MS=60000

# ══════════════════════════════════════════════════════════════════
# External Downloader API (Fallback)
# ══════════════════════════════════════════════════════════════════
# Leave empty to use local binaries only
# Configure if using external worker for IP-blocked platforms
DOWNLOADER_API_URL=
DOWNLOADER_API_KEY=

# ══════════════════════════════════════════════════════════════════
# AI Configuration
# ══════════════════════════════════════════════════════════════════
AI_PROVIDER=mock  # mock | cloudflare | openai

# Vercel AI Gateway (text generation and support translation)
# Vercel deployments authenticate through OIDC automatically.
# Optional local server-only key; never expose it through NEXT_PUBLIC_*.
AI_GATEWAY_API_KEY=
# Free-only allowlist also permits reflection/beam-free.
AI_GATEWAY_TEXT_MODEL=nvidia/nemotron-3.5-lightning-free

# ══════════════════════════════════════════════════════════════════
# Vercel Integration (Auto-generated)
# ══════════════════════════════════════════════════════════════════
# These are auto-generated by Vercel CLI - do not set manually
# VERCEL_OIDC_TOKEN=...

# ══════════════════════════════════════════════════════════════════
# Vercel Blob Storage
# ══════════════════════════════════════════════════════════════════
BLOB_READ_WRITE_TOKEN=

