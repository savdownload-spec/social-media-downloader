# ==============================
# Site
# ==============================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="SavDown"

# ==============================
# Database (PostgreSQL)
# ==============================
DATABASE_URL="postgresql://user:password@localhost:5432/downloader?schema=public"

# ==============================
# NextAuth
# ==============================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ==============================
# Redis (rate limiting + cache)
# ==============================
# Local: redis://localhost:6379
# Upstash: use the UPSTASH_REDIS_REST_URL/TOKEN pair instead
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================
# Downloader — yt-dlp
# ==============================
# Option A: local binary (preferred for self-hosted)
#   Install: pip install yt-dlp
#   Then set: YTDLP_BIN=/usr/local/bin/yt-dlp
YTDLP_BIN=yt-dlp

# Timeout for yt-dlp metadata extraction in milliseconds
YTDLP_TIMEOUT_MS=30000

# Option B: sidecar service (docker-compose ytdlp service)
#   DOWNLOADER_API_URL=http://localhost:8001/info
#   DOWNLOADER_API_KEY=   (optional bearer token)
DOWNLOADER_API_URL=
DOWNLOADER_API_KEY=

# ==============================
# Downloader — gallery-dl
# ==============================
# Option A: local binary
#   Install: pip install gallery-dl
GALLERY_DL_BIN=gallery-dl

# Timeout in milliseconds
GALLERY_DL_TIMEOUT_MS=30000

# Option B: sidecar service
#   GALLERY_DL_API_URL=http://localhost:8002/info
GALLERY_DL_API_URL=

# Optional: gallery-dl config file path for cookies/auth
# GALLERY_DL_CONFIG=/etc/gallery-dl.conf

# ==============================
# Admin
# ==============================
ADMIN_EMAILS="admin@example.com"

# ==============================
# Analytics (optional)
# ==============================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
