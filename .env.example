# ==============================
# Site
# ==============================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="SavDown"

# ==============================
# Database (PostgreSQL)
# ==============================
# On Neon, take BOTH strings for the same branch:
#   DATABASE_URL â€” the POOLED endpoint (hostname contains "-pooler"). Used for
#     every runtime query; serverless functions open a connection per
#     invocation and would exhaust the direct endpoint.
#   DIRECT_URL   â€” the same string WITHOUT "-pooler". Used only for schema
#     changes (prisma db push / migrate), which do not work reliably through
#     PgBouncer transaction pooling.
# DIRECT_URL is required, not optional â€” Prisma refuses to load the schema
# without it. Set both locally and on Vercel.
DATABASE_URL="postgresql://user:password@localhost:5432/downloader?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/downloader?schema=public"

# ==============================
# NextAuth
# ==============================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ==============================
# Redis (rate limiting + cache)
# ==============================
# Local: redis://localhost:6379
# Upstash: use the UPSTASH_REDIS_REST_URL/TOKEN pair instead
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==============================
# Downloader â€” yt-dlp
# ==============================
# Leave unset on Vercel/serverless: falls back automatically to the static
# Linux binary bundled at bin/yt-dlp_linux (see src/lib/binaryPaths.ts),
# which includes curl_cffi for TikTok's --impersonate bypass. Only set this
# explicitly for a self-hosted VPS/Docker install, e.g.:
#   Install: pip install yt-dlp
#   Then set: YTDLP_BIN=/usr/local/bin/yt-dlp
YTDLP_BIN=

# Timeout for yt-dlp metadata extraction in milliseconds
YTDLP_TIMEOUT_MS=30000

# Option B: sidecar service (docker-compose ytdlp service)
#   DOWNLOADER_API_URL=http://localhost:8001/info
#   DOWNLOADER_API_KEY=   (optional bearer token)
DOWNLOADER_API_URL=
DOWNLOADER_API_KEY=

# ==============================
# Video processing â€” FFmpeg
# ==============================
# Leave unset everywhere: resolved automatically via the `ffmpeg-static` npm
# package, which downloads the correct binary for whatever platform runs
# `npm install` (works locally and on Vercel's Linux build). Only set this
# to override with a system install.
FFMPEG_BIN=
FFMPEG_TIMEOUT_MS=60000

# ==============================
# Downloader â€” gallery-dl
# ==============================
# Unlike yt-dlp/ffmpeg, gallery-dl has no official standalone binary release
# (Python-only, no PyInstaller artifact) â€” it cannot be bundled into a
# Vercel/serverless deployment. It needs GALLERY_DL_BIN pointing at an
# install on a persistent server (VPS/Docker), or DOWNLOADER_API_URL-style
# sidecar support (not yet wired â€” see services/gallerydl). On Vercel with
# neither configured, gallery-dl-dependent tools (Instagram photo/story/
# profile-picture, Pinterest image, TikTok photo) will not work.
#   Install: pip install gallery-dl
GALLERY_DL_BIN=gallery-dl

# Timeout in milliseconds
GALLERY_DL_TIMEOUT_MS=30000

# Option B: sidecar service
#   GALLERY_DL_API_URL=http://localhost:8002/info
GALLERY_DL_API_URL=

# Optional: gallery-dl config file path for cookies/auth
# GALLERY_DL_CONFIG=/etc/gallery-dl.conf

# ==============================
# Billing â€” Stripe
# ==============================
# Checkout is disabled and the pricing page buttons return a clear error
# until STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are both set.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in dev,
# or the endpoint's signing secret in the Stripe dashboard for production.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_..., NOT product ids) created in the Stripe dashboard.
# Each must match the amount in src/lib/billing.ts (which mirrors the public
# model in src/config/pricing.ts):
#   Pro   $9.99/mo   $89/yr
# Any price left blank simply cannot be bought â€” its button reports that the
# plan is unavailable rather than charging the wrong amount.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# One-time payments: 300 = $5 Â· 1,000 = $14 Â· 3,000 = $36 Â· Lifetime = $199
STRIPE_PRICE_PACK_STARTER=
STRIPE_PRICE_PACK_CREATOR=
STRIPE_PRICE_PACK_POWER=
STRIPE_PRICE_LIFETIME=

# ==============================
# Admin
# ==============================
ADMIN_EMAILS="admin@example.com"

# ==============================
# Analytics (optional)
# ==============================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ==============================
# Geolocation (optional)
# ==============================
# Vercel edge geo headers provide the timezone used by Auto theme.
# On non-Vercel hosts, Auto theme falls back to the visitor's browser timezone.

# ==============================
# Support message translation (optional)
# ==============================
# Server-only provider credentials. If unset, language detection still works and
# agents/customers can retry translation later through the secure support route.
SUPPORT_TRANSLATION_API_KEY=
SUPPORT_TRANSLATION_API_BASE=
SUPPORT_TRANSLATION_MODEL=gpt-4o-mini

# AI image generation
AI_PROVIDER=mock
AI_IMAGE_MODEL=gpt-image-1
AI_PROVIDER_API_KEY=
AI_IMAGE_CREDIT_COST=5
AI_MAX_CONCURRENT_JOBS=2
AI_MAX_QUEUE_SIZE=8
AI_MAX_GENERATIONS_PER_USER_DAY=20
AI_MAX_REQUESTS_PER_IP_MINUTE=6
AI_PROVIDER_TIMEOUT_MS=60000
AI_QUEUE_WAIT_TIMEOUT_MS=45000
